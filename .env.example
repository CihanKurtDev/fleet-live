# Lokale Demo-Defaults. Alle Werte sind optional.
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/fleetlive.db
CORS_ORIGIN=*
TELEMETRY_TICK_MS=400
TELEMETRY_BATCH_SIZE=32
TELEMETRY_KEEP_PER_VEHICLE=100
TRIP_RETENTION_DAYS=90
LOG_LEVEL=info
# Nur für einen bewusst betriebenen, isolierten Demo-Seed in Produktion:
ALLOW_DEMO_ACCOUNTS=false
