# Lokale Demo-Defaults. Alle Werte sind optional.
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/fleetlive.db
CORS_ORIGIN=*
TELEMETRY_TICK_MS=400
TELEMETRY_BATCH_SIZE=32
TELEMETRY_KEEP_PER_VEHICLE=100
TRIP_RETENTION_DAYS=90
LOG_LEVEL=info
# Nur für einen bewusst betriebenen, isolierten Demo-Seed in Produktion:
ALLOW_DEMO_ACCOUNTS=false

# Mail. Ohne SMTP_URL schreibt die Entwicklung den Link ins Server-Log.
# SMTP_URL=smtp://user:pass@localhost:1025
# MAIL_FROM=fleet-live <noreply@localhost>
# WEB_ORIGIN=http://localhost:5173

# Google / Microsoft Login. Leer = Buttons erscheinen nicht.
# Redirect-URIs im IdP: {WEB_ORIGIN}/api/auth/sso/google/callback
# und {WEB_ORIGIN}/api/auth/sso/microsoft/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# TOTP_ENCRYPTION_KEY=
